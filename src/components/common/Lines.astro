---
import type { Page } from "@/types/Page";

interface Props {
    page?: Page;
}

const { page } = Astro.props;
---

<div
    class="pointer-events-none fixed top-0 left-0 z-10 flex h-screen w-full justify-between px-4 md:justify-evenly md:px-0"
>
    {
        Array.from({ length: 3 }).map((_, index) => (
            <div
                class:list={[
                    "bg-tertiary-back h-full w-0.25",
                    "data-[page-line=home]:[clip-path:inset(0%_0%_100%_0%)]",
                ]}
                data-page-line={page}
            />
        ))
    }
</div>
