---
import Links from "@/data/Links";
import Modes from "@/data/Modes";
import Snses from "@/data/Sns";

// 3つ＋2つに分割
const rowModes = [Modes.slice(0, 3), Modes.slice(3, 5)];
---

<header class="fixed top-0 left-0 z-30 w-full">
    <div class="px-7.5 py-4.5 md:px-0 md:pt-8 md:pb-3">
        <div class="group w-full md:grid md:grid-cols-[repeat(24,minmax(0,1fr))]">
            <a
                href="/"
                class="header-link transition-primary group-has-[.header-link:hover]:not-[&:hover]:text-other-text h-fit md:ml-7.5"
            >
                KS
            </a>
            <ul class="col-start-9 flex gap-x-8">
                {
                    Links.map((link) => (
                        <li class="h-fit uppercase font-stretch-extra-condensed">
                            <a
                                href={link.href}
                                class="header-link text-link group-has-[.header-link:hover]:not-[&:hover]:text-other-text transition-primary"
                            >
                                {link.text}
                            </a>
                        </li>
                    ))
                }
            </ul>
            <div class="col-start-16 flex flex-col gap-y-4.5 md:gap-y-1">
                {
                    rowModes.map((row) => (
                        <div class="flex flex-col gap-y-4.5 md:flex-row md:gap-x-1">
                            {row.map((mode, index) => (
                                <>
                                    <button
                                        type="button"
                                        data-theme-btn={mode.theme}
                                        class="header-link text-theme text-secondary-text group-has-[.header-link:hover]:not-[&:hover]:text-other-text transition-primary uppercase"
                                    >
                                        {mode.theme}
                                    </button>
                                    {index < row.length - 1 && (
                                        <span class="text-other-text">/</span>
                                    )}
                                </>
                            ))}
                        </div>
                    ))
                }
            </div>
            <ul class="flex gap-x-4 md:col-end-25 md:mr-7.5 md:justify-end">
                {
                    Snses.map((el) => (
                        <li class="h-fit w-fit">
                            <a
                                href={el.href}
                                target={el.target}
                                rel={el.target ? "noopener noreferrer" : undefined}
                                class="header-link group-has-[.header-link:hover]:not-[&:hover]:text-other-text transition-primary"
                            >
                                {el.text}
                            </a>
                        </li>
                    ))
                }
            </ul>
        </div>
    </div>
</header>
