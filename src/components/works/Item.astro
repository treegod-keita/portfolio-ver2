---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
    className?: string;
    num: number;
    src: ImageMetadata;
    width?: number;
    height?: number;
    title: string;
    info: string;
}

const { className, num, src, width = 332, height = 174, title, info } = Astro.props;
---

<li class:list={["flex flex-col gap-y-1.5 md:flex-row md:gap-x-3.5", className]}>
    <div class="text-reverse md:shrink-0">0{num}</div>
    <button>
        <div class="flex flex-col gap-y-2.5 md:gap-y-3">
            <div class="w-full overflow-hidden">
                <Image
                    class="h-full w-full"
                    src={src}
                    alt={title}
                    width={width}
                    height={height}
                    format="webp"
                />
            </div>
            <div>
                <p class="text-h4-pc">{title}</p>
                <p class="text-cap-pc mt-2 md:mt-2.5">{info}</p>
            </div>
        </div>
    </button>
</li>
